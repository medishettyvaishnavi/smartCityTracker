### Create Complaint
POST http://localhost:5000/api/complaints
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYTk3ZTI5NzEyMTljNTRkZjY5ZTAyYiIsInJvbGUiOiJjaXRpemVuIiwiaWF0IjoxNzg5NDkyOTUwLCJleHAiOjE3ODk1NzkzNTB9.cn6WJYjiAaIMjcaNGG76tET-dTrHMf3mE9WVWTTAN34

{
  "title": "Garbage not collected",
  "description": "Garbage has not been collected for three days on the main street.",
  "category": "Sanitation & Garbage",
  "priority": "medium",
  "location": {
    "address": "Madhapur",
    "city": "Hyderabad",
    "coordinates": {
      "lat": 17.4486,
      "lng": 78.3908
    }
  },
  "images": []
}

