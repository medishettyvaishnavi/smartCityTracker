### Register a new user
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "Test12345"
}

### Login
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Test12345"
}

### Protected route
GET http://localhost:5000/api/protected
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYTY3NDExN2NmM2M3ZWRiZWFkMGFiZiIsInJvbGUiOiJjaXRpemVuIiwiaWF0IjoxNzg5MzE4ODI5LCJleHAiOjE3ODk0MDUyMjl9.0r_plk3k2f8r8Xs8rE2PvKi6f3pwwlSn-cfTYJWQEwQ

### Protected route without token
GET http://localhost:5000/api/protected

### Register Citizen A
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "Citizen A",
  "email": "citizenA@example.com",
  "password": "Test12345"
}

### Login Citizen A
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "citizenA@example.com",
  "password": "Test12345"
}

### Create Complaint
POST http://localhost:5000/api/complaints
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhYTk3ZTI5NzEyMTljNTRkZjY5ZTAyYiIsInJvbGUiOiJjaXRpemVuIiwiaWF0IjoxNzg5NDkyOTUwLCJleHAiOjE3ODk1NzkzNTB9.cn6WJYjiAaIMjcaNGG76tET-dTrHMf3mE9WVWTTAN34

{
  "title": "Garbage not collected",
  "description": "Garbage has not been collected for three days on the main street.",
  "category": "Sanitation & Garbage",
  "priority": "medium",
  "location": {
    "address": "Madhapur",
    "city": "Hyderabad",
    "coordinates": {
      "lat": 17.4486,
      "lng": 78.3908
    }
  },
  "images": []
}

